# Cosmonym gate: the only thing exposed to the network. It decides who may
# talk to the app, establishes the real visitor IP, and shields the app from
# slow or oversized requests. The app itself sits on an internal-only network.
#
# Env (set in the Portainer stack):
#   GATE_ALLOW  who may connect: "all" while testing on the LAN, or the reverse
#               proxy's address (e.g. 10.0.101.1) once the domain is live
#   NPM_PROXY   the reverse proxy (Nginx Proxy Manager) in front of this gate
#
# Who is the visitor?
#   The router forwards 443 from anywhere, so someone can skip Cloudflare, hit
#   NPM directly with "Host: cosmonym.app" and send a fake CF-Connecting-IP.
#   NPM records the address it really received the request from in X-Real-IP
#   (it overwrites any client copy). CF-Connecting-IP is only believed when that
#   address is a Cloudflare edge; otherwise X-Real-IP itself is the visitor.

# Did this request come from NPM?
geo $from_proxy {
    default      0;
    ${NPM_PROXY} 1;
}

# Did NPM receive it from Cloudflare? (https://www.cloudflare.com/ips/)
geo $http_x_real_ip $npm_peer_is_cloudflare {
    default            0;
    173.245.48.0/20    1;
    103.21.244.0/22    1;
    103.22.200.0/22    1;
    103.31.4.0/22      1;
    141.101.64.0/18    1;
    108.162.192.0/18   1;
    190.93.240.0/20    1;
    188.114.96.0/20    1;
    197.234.240.0/22   1;
    198.41.128.0/17    1;
    162.158.0.0/15     1;
    104.16.0.0/13      1;
    104.24.0.0/14      1;
    172.64.0.0/13      1;
    131.0.72.0/22      1;
    2400:cb00::/32     1;
    2606:4700::/32     1;
    2803:f800::/32     1;
    2405:b500::/32     1;
    2405:8100::/32     1;
    2a06:98c0::/29     1;
    2c0f:f248::/32     1;
}

map "$from_proxy:$npm_peer_is_cloudflare" $client_ip {
    "1:1"   $http_cf_connecting_ip;   # Cloudflare -> NPM -> gate: Cloudflare's word
    "1:0"   $http_x_real_ip;          # straight to NPM, bypassing Cloudflare: who NPM saw
    default $remote_addr;             # straight to the gate (LAN)
}
# Only NPM may say the visitor used HTTPS; anyone else is plain HTTP.
map $from_proxy $forward_proto {
    1       $http_x_forwarded_proto;
    default http;
}
map $client_ip $forward_ip {
    ""      $remote_addr;
    default $client_ip;
}

log_format gate '$remote_addr via=$from_proxy cf=$npm_peer_is_cloudflare client=$forward_ip "$request" $status $body_bytes_sent $request_time';

server {
    listen 8080;
    server_tokens off;
    access_log /dev/stdout gate;

    allow 127.0.0.1;
    allow ${GATE_ALLOW};
    deny  all;

    client_max_body_size   32k;
    client_header_timeout  10s;
    client_body_timeout    10s;
    send_timeout           30s;
    large_client_header_buffers 4 8k;

    location = /api/stream {
        proxy_pass http://app:3000;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
        include /etc/nginx/proxy_headers.conf;
    }

    # share-card uploads are the only requests allowed a larger body
    location ~ "^/api/world/[a-z0-9-]{1,32}/card$" {
        client_max_body_size 1m;
        proxy_pass http://app:3000;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_read_timeout 30s;
        include /etc/nginx/proxy_headers.conf;
    }

    location / {
        proxy_pass http://app:3000;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        include /etc/nginx/proxy_headers.conf;
    }
}
